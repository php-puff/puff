$command = $argv[1] ?? null;
$composer = __DIR__ . '/vendor/autoload.php';

if (!\is_file($composer)) {
    \fwrite(STDERR, "Puff composer is not installed. Run composer install first.\n");
    exit(1);
}

require $composer;


if ($command === 'run') {
    if (\in_array('--watch', $argv, true)) {
        puff_watch(__DIR__);
    }
    application()->run();
    exit(0);
}


if (!\class_exists(Cmd\Application::class)) {
    \fwrite(STDERR, "Puff Console is not installed. Run composer install first.\n");
    exit(1);
}

exit((new Cmd\Application(__DIR__))->run());

/** @return never */
function puff_watch(string $root): never
{
    \putenv('PUFF_WATCH=1');
    $_ENV['PUFF_WATCH'] = '1';
    $snapshot = puff_watch_snapshot($root);
    $process = puff_watch_start($root);
    $stopping = false;
    if (\function_exists('pcntl_async_signals')) {
        \pcntl_async_signals(true);
        foreach ([SIGINT, SIGTERM, SIGQUIT] as $signal) {
            \pcntl_signal($signal, static function () use (&$stopping): void {
                $stopping = true;
            });
        }
    }

    \fwrite(STDOUT, "Puff watch · development mode\n");
    \fwrite(STDOUT, "Watching application files and installed Puff packages\n");
    try {
        while (!$stopping) {
            \usleep(500_000);
            $status = \proc_get_status($process);
            if (!$status['running']) {
                \proc_close($process);
                \usleep(500_000);
                $process = puff_watch_start($root);
                continue;
            }

            $current = puff_watch_snapshot($root);
            if ($current === $snapshot) {
                continue;
            }
            $snapshot = $current;
            \fwrite(STDOUT, "Change detected. Restarting Puff...\n");
            puff_watch_stop($process);
            $process = puff_watch_start($root);
        }
    } finally {
        puff_watch_stop($process);
    }

    exit(0);
}

/** @return resource */
function puff_watch_start(string $root): mixed
{
    $process = \proc_open(
        [PHP_BINARY, $root . '/puff', 'run'],
        [0 => STDIN, 1 => STDOUT, 2 => STDERR],
        $pipes,
        $root,
    );
    if (!\is_resource($process)) {
        throw new \RuntimeException('Unable to start Puff development process.');
    }
    return $process;
}

/** @param resource $process */
function puff_watch_stop(mixed $process): void
{
    if (!\is_resource($process)) {
        return;
    }
    if (\proc_get_status($process)['running']) {
        \proc_terminate($process, SIGTERM);
        $deadline = \microtime(true) + 5.0;
        while (\proc_get_status($process)['running'] && \microtime(true) < $deadline) {
            \usleep(50_000);
        }
        if (\proc_get_status($process)['running']) {
            \proc_terminate($process, SIGKILL);
        }
    }
    \proc_close($process);
}

/** @return array<string, string> */
function puff_watch_snapshot(string $root): array
{
    $snapshot = [];
    $directories = ['app', 'cmd', 'config', 'database', 'job', 'pipeline', 'service'];
    foreach (\glob($root . '/vendor/puff/*') ?: [] as $package) {
        foreach (['src', 'lib', 'config', 'stub'] as $directory) {
            if (\is_dir($package . '/' . $directory)) {
                $directories[] = $package . '/' . $directory;
            }
        }
    }
    foreach ($directories as $directory) {
        $path = \str_starts_with($directory, '/') ? $directory : $root . '/' . $directory;
        if (!\is_dir($path)) {
            continue;
        }
        $iterator = new \RecursiveIteratorIterator(
            new \RecursiveDirectoryIterator($path, \FilesystemIterator::SKIP_DOTS),
        );
        foreach ($iterator as $file) {
            if (!$file->isFile()) {
                continue;
            }
            $name = $file->getPathname();
            $snapshot[$name] = $file->getMTime() . ':' . $file->getSize();
        }
    }
    foreach (['.env', 'composer.json', 'composer.lock', 'puff'] as $file) {
        $path = $root . '/' . $file;
        if (\is_file($path)) {
            $snapshot[$path] = \filemtime($path) . ':' . \filesize($path);
        }
    }
    \ksort($snapshot);
    return $snapshot;
}
